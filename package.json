{
  "name": "minds",
  "displayName": "minds",
  "description": "Markdown 即时编辑、文档内 AI、离线图形与本地快照历史。",
  "version": "0.2.1",
  "publisher": "minds-local",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/ChaomingZhangCN/minds.git" },
  "engines": { "vscode": "^1.105.0", "node": ">=22" },
  "categories": ["Other", "Visualization", "Machine Learning"],
  "keywords": ["markdown", "ai", "drawio", "excalidraw", "snapshot"],
  "main": "./dist/extension.cjs",
  "icon": "media/icon.png",
  "activationEvents": ["onCustomEditor:minds.markdown", "onLanguage:markdown"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": "limited", "description": "可编辑预览；AI、资源写入与历史整理只在受信任工作区启用。" },
    "virtualWorkspaces": { "supported": false, "description": "首版需要本地或 Remote Extension Host 文件系统。" }
  },
  "contributes": {
    "customEditors": [{ "viewType": "minds.markdown", "displayName": "minds Markdown", "selector": [{ "filenamePattern": "*.md" }, { "filenamePattern": "*.markdown" }], "priority": "default" }],
    "commands": [
      { "command": "minds.open", "title": "minds: 打开 Markdown 编辑器" },
      { "command": "minds.configureProvider", "title": "minds: 配置 AI Provider" },
      { "command": "minds.clearCredential", "title": "minds: 删除 AI 凭证" },
      { "command": "minds.history", "title": "minds: 查看文档历史" },
      { "command": "minds.maintenance", "title": "minds: 预览并整理本地历史" }
    ],
    "menus": { "editor/title": [{ "command": "minds.open", "when": "resourceExtname == .md", "group": "navigation" }] },
    "configuration": {
      "title": "minds",
      "properties": {
        "minds.ai.provider": { "type": "string", "enum": ["none", "openai-compatible", "anthropic"], "default": "none", "scope": "application", "description": "只读取用户级 Provider 配置；凭证使用 SecretStorage。" },
        "minds.ai.baseUrl": { "type": "string", "default": "", "scope": "application", "description": "留空使用 Provider 默认地址。请求从 Extension Host 所在机器发出。" },
        "minds.ai.model": { "type": "string", "default": "", "scope": "application", "description": "Provider 模型 ID。" },
        "minds.ai.maxOutputTokens": { "type": "number", "default": 8192, "minimum": 256, "maximum": 64000, "scope": "application" },
        "minds.ai.maxContextCharacters": { "type": "number", "default": 64000, "minimum": 1000, "maximum": 500000, "scope": "application", "description": "超过预算时拒绝发送，不静默截断文档。" },
        "minds.ai.timeoutSeconds": { "type": "number", "default": 120, "minimum": 10, "maximum": 600, "scope": "application" },
        "minds.ai.refusalFallback": { "type": "boolean", "default": true, "scope": "application", "description": "Anthropic 支持的模型启用服务端拒绝回退；仍在相同 Provider 内执行。可关闭。" },
        "minds.history.enabled": { "type": "boolean", "default": true, "scope": "application" },
        "minds.history.maxSnapshotsPerDocument": { "type": "number", "default": 100, "minimum": 1, "maximum": 10000, "scope": "application" },
        "minds.history.detailedRetentionDays": { "type": "number", "default": 7, "minimum": 0, "scope": "application" },
        "minds.history.expireAfterDays": { "type": "number", "default": 30, "minimum": 1, "scope": "application" },
        "minds.history.timeZone": { "type": "string", "default": "UTC", "scope": "application" },
        "minds.history.maintenanceIntervalMinutes": { "type": "number", "default": 60, "minimum": 5, "scope": "application" },
        "minds.history.gcGraceHours": { "type": "number", "default": 24, "minimum": 1, "scope": "application" }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:drawio": "node scripts/prepare-drawio.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "dev:webview": "node scripts/serve-webview.mjs",
    "test:browser": "playwright test",
    "test:extension": "node scripts/test-extension.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@excalidraw/excalidraw": "0.18.1",
    "@lezer/markdown": "1.8.1",
    "dompurify": "^3.2.6",
    "echarts": "^6.0.0",
    "fast-xml-parser": "^5.2.5",
    "markdown-it": "^14.1.0",
    "mermaid": "11.17.2",
    "openai": "7.57.0",
    "proper-lockfile": "^4.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.105.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "4.1.1",
    "esbuild": "^0.25.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
